# Copy this file to .env and fill in your actual key(s).
# Never commit the real .env file (it's already in .gitignore).

# OpenRouter (recommended - one key, many free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Groq (alternative - free tier, fast): https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (alternative free tier): https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Path to the sample database
DB_PATH=data/chinook.db
